<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>User Profile</title>
</head>
<body>
    <div>
        <h2>User Profile Settings</h2>
        <div id="msg"></div>

        <form id="profileForm">
            <div>
                <label for="username">Username:</label>
                <input type="text" id="username" name="username" value="<%= currentUser.username %>" required>
            </div>
            <div>
                <label for="email">Email Address:</label>
                <input type="email" id="email" name="email" value="<%= currentUser.email %>" required>
            </div>
            <button type="submit">Save Changes</button>
        </form>

        <hr>

        <div>
            <p><a href="/changePassword">Change Password</a></p>
            <button id="logoutBtn">Logout</button>
        </div>
    </div>

    <script>
        document.getElementById('profileForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const msg = document.getElementById('msg');
            msg.innerText = '';

            const username = document.getElementById('username').value;
            const email = document.getElementById('email').value;

            try {
                const res = await fetch('/auth/update', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, email })
                });

                const data = await res.json();

                if (data.success) {
                    msg.style.color = 'green';
                    msg.innerText = 'Profile updated successfully!';
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    msg.style.color = 'red';
                    msg.innerText = data.message || 'Update failed';
                }
            } catch (err) {
                msg.style.color = 'red';
                msg.innerText = 'System connection error.';
            }
        });

        // Logout
        document.getElementById('logoutBtn').addEventListener('click', async () => {
            if (!confirm('Are you sure you want to logout?')) return;

            try {
                const res = await fetch('/auth/logout', { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    alert('Logged out successfully!');
                    window.location.href = '/login';
                }
            } catch (err) {
                alert('Logout failed');
            }
        });
    </script>
</body>
</html>