<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Change Password</title>
</head>
<body>
    <div>
        <h2>Change Password</h2>
        <div id="msg"></div>

        <form id="passwordForm">
            <div>
                <label for="password">Current Password:</label>
                <input type="password" id="password" name="password" required>
            </div>
            <div>
                <label for="newPassword">New Password:</label>
                <input type="password" id="newPassword" name="newPassword" required>
            </div>
            <button type="submit">Confirm Change Password</button>
            <p><a href="/user">Back to Profile</a></p>
        </form>
    </div>

    <script>
        document.getElementById('passwordForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const msg = document.getElementById('msg');
            msg.innerText = '';

            const password = document.getElementById('password').value;
            const newPassword = document.getElementById('newPassword').value;

            try {
                const res = await fetch('/auth/change-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ password, newPassword })
                });

                const data = await res.json();

                if (data.success) {
                    msg.style.color = 'green';
                    msg.innerText = 'Password changed successfully!';
                    document.getElementById('passwordForm').reset();
                } else {
                    msg.style.color = 'red';
                    msg.innerText = data.message || 'Change password failed';
                }
            } catch (err) {
                msg.style.color = 'red';
                msg.innerText = 'System connection error.';
            }
        });
    </script>
</body>
</html>